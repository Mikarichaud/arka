# Production env — à copier en .env.production sur le VPS et compléter avec les vraies valeurs.
# NE PAS COMMITTER .env.production (juste cet exemple).

# ─── Server ───
NODE_ENV=production
PORT=5003

# MongoDB sur le host, accessible via host.docker.internal depuis le conteneur server
# Crée d'abord l'user "roulade" avec le password de ton choix (cf. scripts/setup-vps.md)
MONGODB_URI=mongodb://roulade:CHANGE_ME_STRONG_PASSWORD@host.docker.internal:27017/roulade-marseillaise?authSource=admin

# JWT — génère un secret aléatoire fort, par exemple : openssl rand -hex 64
JWT_SECRET=CHANGE_ME_RANDOM_HEX_64
JWT_EXPIRES_IN=7d

# Cloudinary (mêmes credentials qu'en dev OU projet dédié prod)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Stripe — passer en mode LIVE (pas test) une fois en prod
# - Récupérer la clé secrète live dans le dashboard
# - Créer un endpoint webhook https://roulademarseillaise.fr/api/payments/webhook
#   et copier sa signing secret ici
# - Créer 2 prices LIVE (mensuel + annuel) et copier leurs IDs
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_MONTHLY=price_xxx
STRIPE_PRICE_ANNUAL=price_xxx

# URL publique du client — utilisée pour les redirections Stripe et les liens dans les emails
CLIENT_URL=https://roulademarseillaise.fr

# Email du propriétaire de l'instance — donne accès à /admin (dashboard live).
# Doit matcher exactement l'email du compte (lowercase). Laisser vide pour
# désactiver complètement le dashboard.
OWNER_EMAIL=michael.richaud.rm@gmail.com

# Mode lancement : ouvre TOUTES les features Premium à tout le monde
# (création packs illimités, salons, upload média, avatar, cosmétiques).
# Mettre à 'true' au lancement, puis 'false' (ou retirer) le jour où on active le freemium.
# Au flip vers false : les users qui ont profité des features Premium pendant la période
# ouverte perdent l'accès — leurs packs/avatars/skins activés ne sont PAS retirés en DB,
# mais ils ne pourront plus en créer/modifier au-delà des limites Free.
# Doit être synchronisé avec VITE_FEATURES_UNLOCKED dans client/.env.production.
FEATURES_UNLOCKED=true

# SMTP transactionnel (boîte roulademarseillaise.fr hébergée chez OVH)
# Crée d'abord la boîte dans le manager OVH, récupère le mot de passe, puis :
#   SMTP_HOST=ssl0.ovh.net  (SSL/465) ou même hôte en STARTTLS/587
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@roulademarseillaise.fr
SMTP_PASS=CHANGE_ME
SMTP_FROM="La Roulade Marseillaise <noreply@roulademarseillaise.fr>"
