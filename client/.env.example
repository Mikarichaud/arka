VITE_API_URL=http://localhost:5000/api
VITE_APP_NAME=La Roulade Marseillaise

# Mode lancement : ouvre toutes les features Premium à tout le monde côté UI.
# - hasPremiumAccess(user) retourne true en permanence
# - /premium et /premium/success redirigent vers /
# - PaywallModal ne s'ouvre jamais
# - Profile masque l'abonnement, badges, banners upsell
# - PackLibrary masque les tags "Premium"
# Doit être synchronisé avec FEATURES_UNLOCKED côté server.
# IMPORTANT : Vite inline cette valeur au BUILD — il faut rebuild le client après changement.
VITE_FEATURES_UNLOCKED=false

# Apple IAP (achat des essais du Passeport sur iOS via RevenueCat).
# Clé publique SDK iOS de RevenueCat. Vide = IAP désactivé (le web utilise Stripe).
# À fournir au build natif (npm run build:store).
VITE_REVENUECAT_IOS_KEY=

# Lien de la fiche App Store (CTA de la page virale /tournee).
VITE_APP_STORE_URL=https://apps.apple.com/fr/app/la-roulade-marseillaise/id6778055823
