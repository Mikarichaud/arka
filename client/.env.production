# Variables Vite pour le build de production.
# Ces valeurs sont INLINÉES dans le bundle JS au build time, donc OK de les committer.
# (Pas de secrets ici — l'API tourne sur le même domaine via Nginx reverse proxy.)
VITE_API_URL=/api
VITE_APP_NAME=La Roulade Marseillaise

# Mode lancement : toutes les features Premium ouvertes à tout le monde (UI).
# Doit être synchronisé avec FEATURES_UNLOCKED côté server (.env.production sur le VPS).
# Pour refermer le freemium : mettre 'false' ici + côté server, puis rebuild client + restart server.
VITE_FEATURES_UNLOCKED=true
