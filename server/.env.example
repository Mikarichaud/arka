PORT=5003
MONGODB_URI=mongodb://localhost:27017/roulade-marseillaise
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLIENT_URL=http://localhost:5177
NODE_ENV=development

# Mode lancement : tout est gratuit pour tout le monde (Free + anonymes inclus).
# - isPremiumActive() retourne true automatiquement
# - requirePremium devient pass-through
# - cosmétiques renvoyés avec owned=true partout
# - active-skin skip le check ownership
# Pour refermer le freemium, mettre à 'false' (ou retirer la ligne) et redémarrer.
# IMPORTANT : doit être synchronisé avec VITE_FEATURES_UNLOCKED côté client.
FEATURES_UNLOCKED=false

# Email du propriétaire de l'instance — donne accès à /admin (dashboard live).
# Doit matcher exactement l'email du compte (lowercase). Laisser vide pour
# désactiver complètement le dashboard.
OWNER_EMAIL=

# Sign in with Apple — audience(s) acceptée(s) pour vérifier l'identity token.
# = bundle id de l'app iOS (+ Services ID séparé par une virgule si SIWA web un jour).
APPLE_BUNDLE_ID=fr.roulademarseillaise.app

# Apple IAP via RevenueCat (achat des essais du Passeport sur iOS).
# REVENUECAT_WEBHOOK_AUTH : valeur du header Authorization configurée dans RevenueCat (secret partagé).
# IAP_PERMIS_PRODUCT_ID : identifiant du produit consommable App Store Connect (ex: passeport_3_essais).
REVENUECAT_WEBHOOK_AUTH=
IAP_PERMIS_PRODUCT_ID=passeport_3_essais

# Passeport Marseillais : l'examen officiel (payant) est fermé par défaut, seul le
# test blanc gratuit est ouvert. Mettre à true pour rouvrir l'examen + l'achat d'essais.
PERMIS_EXAM_ENABLED=false

# Stripe — à remplir depuis dashboard.stripe.com
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_MONTHLY=price_xxx
STRIPE_PRICE_ANNUAL=price_xxx

# SMTP transactionnel — pour le reset de mot de passe (boîte roulademarseillaise.fr).
# Si SMTP_HOST est vide en dev, le serveur log le lien de reset en console au lieu
# d'envoyer un mail (pratique pour tester sans boîte mail configurée).
# Pour OVH : ssl0.ovh.net en SSL/465, ou ssl0.ovh.net en STARTTLS/587.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@roulademarseillaise.fr
SMTP_PASS=
SMTP_FROM="La Roulade Marseillaise <noreply@roulademarseillaise.fr>"